// ============================================================
// ZENQOR TECHNOLOGIES - firestore.rules (SECURE v3.1)
// ============================================================
// PERUBAHAN v3.1:
//   - getUserRole() kini baca dokumen guna UID (request.auth.uid)
//     yang konsisten dengan cara app.js menyimpan data pengguna.
//   - Pengguna hanya boleh kemas kini status presence rekod pekerja sendiri.
//   - Hanya role Client dibenarkan menggunakan domain email luar.
//   - Sokong migrasi UID automatik melalui pending_access semasa login.
//   - Benarkan penyelarasan identiti claim berdasarkan Employee ID kekal.
//   - Sokong Payment Voucher dengan pencipta yang boleh diaudit.
//   - Hadkan bacaan koleksi pekerja dan pelanggan mengikut role/pemilik.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Baca role dari dokumen users/{uid} — UID sebagai doc ID
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'Superadmin';
    }

    function isDirector() {
      return isAuthenticated() && getUserRole() == 'Director';
    }

    function isAdmin() {
      return isSuperadmin() || isDirector();
    }

    function isHR() {
      return isAuthenticated() && getUserRole() == 'HR';
    }

    function isAccount() {
      return isAuthenticated() && getUserRole() == 'Account';
    }

    function isIT() {
      return isAuthenticated() && getUserRole() == 'IT';
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() == 'Staff';
    }

    function isClient() {
      return isAuthenticated() && getUserRole() == 'Client';
    }

    function hasAllowedRoleEmail(data) {
      return data.role == 'Client' || (
        data.email is string && data.email.matches('.*@zenq0r[.]com$')
      );
    }

    function hasMatchingPendingAccess() {
      return isAuthenticated() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/pending_access/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/pending_access/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    match /settings/{docId} {
      allow read, write: if isAdmin() || isIT();
    }

    match /users/{userId} {
      // Pengguna baca dokumen sendiri; hanya Superadmin & Director baca semua pengguna.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow create: if (
        request.auth.uid == userId &&
        hasMatchingPendingAccess() &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == get(/databases/$(database)/documents/pending_access/$(request.auth.token.email)).data.role
      ) || (isAdmin() && hasAllowedRoleEmail(request.resource.data));
      allow delete: if isAdmin();
      allow update: if (isAdmin() && hasAllowedRoleEmail(request.resource.data)) || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'mustChangePassword'])
      );
    }

    match /pending_access/{email} {
      allow read: if isAdmin() || (
        isAuthenticated() && request.auth.token.email == email
      );
      allow create, update: if isAdmin() &&
        request.resource.data.email == email &&
        hasAllowedRoleEmail(request.resource.data);
      allow delete: if isAdmin() || (
        isAuthenticated() && request.auth.token.email == email
      );
    }

    match /employees/{empId} {
      allow read: if isAdmin() || isHR() || isAccount() || (
        (isStaff() || isIT()) && resource.data.email == request.auth.token.email
      );
      allow create, delete: if isAdmin() || isHR();
      allow update: if isAdmin() || isHR() || (
        isAuthenticated() &&
        resource.data.email is string &&
        request.auth.token.email is string &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.presenceUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'presenceStatus', 'isOnline', 'presenceUid', 'presenceUpdatedAt', 'lastSeen'
        ])
      );
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || isHR() || isAccount() || (
        isClient() && resource.data.clientEmail == request.auth.token.email
      );
      allow write: if isAdmin() || isHR() || isAccount();
    }

    match /docs/{docId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isHR() || isAccount() || isIT() ||
        (isClient() && resource.data.raw.clientEmail == request.auth.token.email)
      );
      allow create, update: if isSuperadmin() || isHR() || isAccount();
      allow delete: if isAdmin();
    }

    match /payslips/{payslipId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isHR() || isAccount() ||
        (isStaff() && resource.data.raw.empEmail == request.auth.token.email)
      );
      allow create, update: if isSuperadmin() || isHR() || isAccount();
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isHR() || isAccount() ||
        (isStaff() && resource.data.empEmail == request.auth.token.email)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.createdByUid == request.auth.uid && (
          (isStaff() && request.resource.data.empEmail == request.auth.token.email) ||
          isAdmin() || isHR() || isAccount()
        );
      allow update: if (
        (isAdmin() || isHR()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'position', 'dept', 'empEmail'
        ])
      ) || (
        isAdmin() &&
        resource.data.status == 'Approved' &&
        request.resource.data.status == 'Approved' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'documentType', 'type', 'finalDecision', 'settlementStatus', 'statusDetail',
          'assignedToUid', 'assignedToName', 'assignedToEmail', 'assignedToRole',
          'approvalPath'
        ])
      ) || (
        isAuthenticated() &&
        resource.data.status == 'Pending HR' &&
        request.resource.data.status == 'Pending HR' &&
        request.resource.data.empNo == resource.data.empNo &&
        ((isStaff() && resource.data.empEmail == request.auth.token.email) ||
          ((isAdmin() || isHR() || isAccount()) && 'createdByUid' in resource.data && resource.data.createdByUid == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'documentType', 'date', 'expenseDate', 'name', 'position', 'dept',
          'payeeName', 'payeeType', 'payeeReference', 'paymentPurpose', 'category',
          'subCategory', 'amount', 'receiptNo', 'description', 'receiptAttachment',
          'receiptAttachmentName', 'receiptAttachmentOriginalBytes', 'createdByUid',
          'createdByEmail', 'createdAt'
        ])
      ) || (
        isHR() && resource.data.status == 'Pending HR' &&
        request.resource.data.status in ['Pending Account', 'Rejected']
      ) || (
        isAccount() && resource.data.status == 'Pending Account' &&
        request.resource.data.status in ['Pending Director', 'Rejected']
      ) || (
        isDirector() && resource.data.status in ['Pending HR', 'Pending Account', 'Pending Director'] &&
        request.resource.data.status in ['Approved', 'Rejected']
      );
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || isIT();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
