// ============================================================
// ZENQOR TECHNOLOGIES - firestore.rules (SECURE v2.3)
// ============================================================
// PERUBAHAN v2.3:
//   - getUserRole() kini baca dokumen guna UID (request.auth.uid)
//     yang konsisten dengan cara app.js menyimpan data pengguna.
//   - Tambah sokongan baca/tulis dokumen pending_uid semasa migrasi.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Baca role dari dokumen users/{uid} — UID sebagai doc ID
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'Superadmin';
    }

    function isDirector() {
      return isAuthenticated() && getUserRole() == 'Director';
    }

    function isAdmin() {
      return isSuperadmin() || isDirector();
    }

    function isHR() {
      return isAuthenticated() && getUserRole() == 'HR';
    }

    function isAccount() {
      return isAuthenticated() && getUserRole() == 'Account';
    }

    function isIT() {
      return isAuthenticated() && getUserRole() == 'IT';
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() == 'Staff';
    }

    function isClient() {
      return isAuthenticated() && getUserRole() == 'Client';
    }

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Pengguna boleh baca dokumen sendiri (guna UID), Superadmin & HR boleh baca semua
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin() || isHR()
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo'])
      );
    }

    match /employees/{empId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR() || isAccount();
    }

    match /docs/{docId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isHR() || isAccount() || isIT() ||
        (isClient() && resource.data.raw.clientEmail == request.auth.token.email)
      );
      allow write: if isAdmin() || isHR() || isAccount();
    }

    match /payslips/{payslipId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isHR() || isAccount() ||
        (isStaff() && resource.data.raw.empEmail == request.auth.token.email)
      );
      allow write: if isAdmin() || isHR() || isAccount();
    }

    match /claims/{claimId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isHR() || isAccount() ||
        (isStaff() && resource.data.empEmail == request.auth.token.email)
      );
      allow create: if isAuthenticated() && request.resource.data.empEmail == request.auth.token.email;
      allow update, delete: if isAdmin() || isHR() || isAccount();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || isIT();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
